{
  // The schedule is the cron in .github/workflows/renovate.yaml, so workflow_dispatch works too.
  // Every automerged non-major bump cuts a patch release.
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["github>yama6a/gha:default.json5", "github>yama6a/gha:php.json5"],

  // ci.yaml fails a PR without a release label. A dependency bump never changes the public API.
  labels: ["patch"],

  packageRules: [
    {
      // composer.lock is not part of the Packagist archive, so a refresh changes nothing for users.
      description: "lock file refreshes publish no release",
      matchUpdateTypes: ["lockFileMaintenance"],
      labels: ["skip-release"],
    },
    {
      // PHPUnit 13 needs PHP 8.4.1, but composer.json still allows PHP 8.3.
      // When PHP 8.3 support goes (December 2027), delete this rule.
      description: "hold PHPUnit below 13 while PHP 8.3 is supported",
      matchPackageNames: ["phpunit/phpunit"],
      allowedVersions: "<13",
    },
  ],
}
