#!/usr/bin/env php
<?php

declare(strict_types=1);

use SubtitleToolbox\Cli\Application;

// A PHP warning on standard output would corrupt subtitle output written there.
if (filter_var(ini_get("display_errors"), FILTER_VALIDATE_BOOL, FILTER_NULL_ON_FAILURE) !== false) {
    ini_set("display_errors", "stderr");
}

$autoloaders = [
    $GLOBALS["_composer_autoload_path"] ?? null,
    __DIR__ . "/../vendor/autoload.php",
    __DIR__ . "/../../../autoload.php",
];
foreach (array_filter($autoloaders) as $autoloader) {
    if (is_file($autoloader)) {
        require $autoloader;
        break;
    }
}

if (!class_exists(Application::class)) {
    fwrite(STDERR, "Cannot find the Composer autoloader. Run \"composer install\" first.\n");
    exit(2);
}

// Word-level JSON transcripts and OCR need more than the PHP default of 128 MB. Any other limit is the user's choice.
if (ini_get("memory_limit") === "128M") {
    ini_set("memory_limit", "512M");
}

exit((new Application())->run($argv));
