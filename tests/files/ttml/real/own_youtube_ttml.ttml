<?xml version="1.0" encoding="utf-8" ?><tt xml:lang="en" xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" ttp:profile="http://www.w3.org/TR/profile/sdp-us" ><head><styling><style xml:id="s1" tts:textAlign="center" tts:extent="90% 90%" tts:origin="5% 5%" tts:displayAlign="after"/><style xml:id="s2" tts:fontSize=".72c" tts:backgroundColor="black" tts:color="white"/></styling><layout><region xml:id="r1" style="s1"/></layout></head><body region="r1"><div><p begin="00:00:00.240" end="00:00:03.120" style="s2">welcome back to the station channel</p><p begin="00:00:03.120" end="00:00:06.480" style="s2">today we look at the new<br />winter timetable</p><p begin="00:00:06.480" end="00:00:09.600" style="s2">the first train now leaves at 5:40</p><p begin="00:00:09.600" end="00:00:12.000" style="s2">[Music]</p><p begin="00:00:12.000" end="00:00:15.360" style="s2">and the bus waits ten minutes &amp; then leaves</p></div></body></tt>
