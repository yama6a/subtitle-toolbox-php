{"version":"1.0.0","segments":[{"speaker":"Marta","startTime":0.5,"endTime":3.0,"body":"The bakery opens at seven."},{"speaker":"Jonas","startTime":3.5,"endTime":6.0,"body":"Is it open on Sunday?"},{"speaker":"Marta","startTime":6.5,"endTime":8.0,"body":"Only in summer."},{"speaker":"Marta","startTime":8.25,"endTime":11.5,"body":"The rest of the year it closes."}]}