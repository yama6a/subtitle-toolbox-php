<SAMI>
<HEAD>
<TITLE>Timetable notes</TITLE>
<SAMIParam>
  Metrics {time:ms;}
  Spec {MSFT:1.0;}
</SAMIParam>
<STYLE TYPE="text/css">
<!--
  P { font-family: Arial; font-weight: normal; color: white; background-color: black; text-align: center; }
  .ENUSCC { name: English; lang: en-US ; SAMIType: CC ; }
-->
</STYLE>
</HEAD>
<BODY>
<-- Open play menu, choose Captions and Subtitles, On if available -->
<-- Open tools menu, Security, Show local captions when present -->
<SYNC Start="1200"><P Class="ENUSCC">The winter timetable starts on Monday.</P></SYNC>
<SYNC Start="3800"><P Class="ENUSCC">&nbsp;</P></SYNC>
<SYNC Start="4100"><P Class="ENUSCC"><i>[announcer]</i><br />The coast train leaves at 6:50.</P></SYNC>
<SYNC Start="7300"><P Class="ENUSCC">Ten minutes earlier &amp; from platform 4.</P></SYNC>
<SYNC Start="10000"><P Class="ENUSCC">&nbsp;</P></SYNC>
<SYNC Start="10400"><P Class="ENUSCC"><font color="#ffff00">The last train</font> still leaves at 11:15.</P></SYNC>
<SYNC Start="13900"><P Class="ENUSCC">&nbsp;</P></SYNC>
</BODY>
</SAMI>