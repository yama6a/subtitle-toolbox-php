<?xml version="1.0" encoding="UTF-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="en">
  <head>
    <ttm:title>Bakery News</ttm:title>
    <layout>
      <region xml:id="bottomCenter" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="after" tts:textAlign="center"/>
      <region xml:id="topLeft" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="before" tts:textAlign="left"/>
      <region xml:id="middleRight" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="center" tts:textAlign="right"/>
    </layout>
  </head>
  <body>
    <div>
      <p begin="10:00:01.000" end="10:00:03.480" region="bottomCenter">The ovens are warm.<br/>Bread is ready at six.</p>
      <p begin="10:00:04.000" end="10:00:06.000" region="bottomCenter"><span tts:color="#ff0000">Fresh</span> rolls are <span tts:fontStyle="italic">warm</span> today.</p>
      <p begin="10:00:07.200" end="10:00:10.000" region="topLeft">Café <span tts:fontStyle="italic">crème</span> $3 or £2<br/><span tts:textDecoration="underline">Äpfel</span> und Straße</p>
      <p begin="10:00:11.000" end="10:00:13.000" region="middleRight">Sign: ‘Open’ ¤</p>
      <p begin="10:00:14.000" end="10:00:20.000" region="bottomCenter"><span tts:color="#ffff00">Our bakery opens at six every morning.</span><br/><span tts:color="#ffff00">The first loaves come out at seven.</span><br/><span tts:color="#ffff00">Rye bread and white bread are baked</span><br/><span tts:color="#ffff00">in the stone oven behind the shop.</span></p>
      <p begin="10:00:30.960" end="10:00:33.000" region="bottomCenter">Good night.</p>
    </div>
  </body>
</tt>
