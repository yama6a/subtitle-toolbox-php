{
  "name": "yama6a/subtitle-toolbox-php",
  "description": "A PHP library that reads, edits and writes subtitles, transcripts and chapter lists in more than 30 formats.",
  "keywords": [
    "subtitle",
    "srt",
    "vtt",
    "webvtt",
    "lrc",
    "mpsub",
    "ass",
    "ttml",
    "scc",
    "pgs",
    "vobsub",
    "ocr",
    "whisper",
    "transcript",
    "chapters",
    "parser",
    "converter"
  ],
  "homepage": "https://github.com/yama6a/subtitle-toolbox-php",
  "license": "MIT",
  "support": {
    "issues": "https://github.com/yama6a/subtitle-toolbox-php/issues",
    "source": "https://github.com/yama6a/subtitle-toolbox-php"
  },
  "autoload": {
    "psr-4": {
      "SubtitleToolbox\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "SubtitleToolbox\\Tests\\": "tests/"
    }
  },
  "require": {
    "php": "^8.3",
    "ext-dom": "*",
    "ext-iconv": "*",
    "ext-mbstring": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5",
    "yama6a/php-glyph-ocr": ">=1.0"
  },
  "suggest": {
    "ext-curl": "for DeepLEngine, GoogleTranslateEngine and OpenAiCompatibleEngine",
    "ext-zlib": "to decode PNG images, which PgsFormatter needs, to compress PNG images and to read zlib-compressed MKV tracks",
    "yama6a/php-glyph-ocr": ">=1.0, for GlyphOcrEngine, the pure PHP OCR of PGS and VobSub image cues where Tesseract is not installed"
  },
  "conflict": {
    "yama6a/php-glyph-ocr": "<1.0"
  },
  "config": {
    "platform": {
      "php": "8.3.0"
    },
    "sort-packages": true
  },
  "scripts": {
    "test": "phpunit"
  }
}
